// Cloudflare Workers config — site files are served as static assets,
// src/worker.js handles /api/* (the enquiry form). Deployed automatically
// by Cloudflare Workers Builds on every push to the production branch.
{
  "name": "keiross",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "observability": { "enabled": true },
  // Non-secret settings. LEADS_SHEET_SECRET (and optional CALLMEBOT) are set as
  // Secrets in the Cloudflare dashboard: keiross -> Settings -> Variables and Secrets.
  "vars": {
    "LEADS_SHEET_WEBHOOK": "https://script.google.com/macros/s/AKfycbwvMHpDfE_1ksy4G_ip5r3QBRxSq_jM0HAhKLX2flqwrQ96Rk42YxVwVUHC-uictB3N9A/exec"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
