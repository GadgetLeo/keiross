// Cloudflare Workers config — site files are served as static assets,
// src/worker.js handles /api/* (the enquiry form). Deployed automatically
// by Cloudflare Workers Builds on every push to the production branch.
{
  "name": "keiross",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
